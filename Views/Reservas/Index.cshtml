@model IEnumerable<Hotel.Web.Models.Reserva>

@{
    ViewData["Title"] = "Listado de Reservas";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-calendar-check"></i> Reservas del Hotel</h2>
            <p class="text-muted">Registro general y control de reservas</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Disponibles" class="btn btn-outline-info">
                Buscar Disponibilidad
            </a>
            <a asp-action="Create" class="btn btn-primary">
                + Nueva Reserva
            </a>
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Éxito:</strong> @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error:</strong> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th># ID</th>
                        <th>Huésped</th>
                        <th>Habitación</th>
                        <th>Fechas (Ingreso - Salida)</th>
                        <th>Noches</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                No se encontraron registros de reservas.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            int noches = Math.Max(1, item.FechaSalida.DayNumber - item.FechaIngreso.DayNumber);
                            decimal precioNoche = item.IdHabitacionNavigation?.IdTipoHabitacionNavigation?.PrecioNoche ?? 0;
                            decimal total = noches * precioNoche;

                            <tr>
                                <td class="fw-bold">#@item.IdReserva</td>
                                <td>
                                    <strong>@item.IdHuespedNavigation?.Apellidos, @item.IdHuespedNavigation?.Nombres</strong>
                                    <div class="small text-muted">DNI: @item.IdHuespedNavigation?.Dni</div>
                                </td>
                                <td>
                                    <strong>Hab. @item.IdHabitacionNavigation?.Numero</strong>
                                    <div class="small text-muted">@item.IdHabitacionNavigation?.IdTipoHabitacionNavigation?.Nombre</div>
                                </td>
                                <td>
                                    <div>@item.FechaIngreso.ToString("dd/MM/yyyy") al @item.FechaSalida.ToString("dd/MM/yyyy")</div>
                                    @if (!string.IsNullOrWhiteSpace(item.Observaciones))
                                    {
                                        <div class="small text-muted fst-italic">Obs: @item.Observaciones</div>
                                    }
                                </td>
                                <td>@noches noche(s)</td>
                                <td class="fw-bold text-success">S/. @total.ToString("F2")</td>
                                <td>
                                    @switch (item.Estado)
                                    {
                                        case "Pendiente":
                                            <span class="badge bg-warning text-dark">Pendiente</span>
                                            break;
                                        case "Confirmada":
                                            <span class="badge bg-success">Confirmada</span>
                                            break;
                                        case "Cancelada":
                                            <span class="badge bg-danger">Cancelada</span>
                                            break;
                                        case "Finalizada":
                                            <span class="badge bg-secondary">Finalizada</span>
                                            break;
                                        default:
                                            <span class="badge bg-info">@item.Estado</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end">
                                    @if (item.Estado == "Pendiente" || item.Estado == "Confirmada")
                                    {
                                        <form asp-action="Cancelar" method="post" class="d-inline" onsubmit="return confirm('¿Seguro que deseas cancelar la reserva #@item.IdReserva?');">
                                            <input type="hidden" name="id" value="@item.IdReserva" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                Cancelar
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Sin acciones</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
