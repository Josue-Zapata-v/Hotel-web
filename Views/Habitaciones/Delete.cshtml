@model Hotel.Web.Models.Habitacion

@{
    ViewData["Title"] = "Eliminar Habitación";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Confirmar Eliminación Lógica</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <strong>Atención:</strong> Esta acción desactivará la habitación (eliminación lógica con <code>Activo = 0</code>). No se borrará físicamente de la base de datos.
                    </div>

                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Número:</dt>
                        <dd class="col-sm-8 fw-bold">@Model.Numero</dd>

                        <dt class="col-sm-4 text-muted">Piso:</dt>
                        <dd class="col-sm-8">Piso @Model.Piso</dd>

                        <dt class="col-sm-4 text-muted">Tipo:</dt>
                        <dd class="col-sm-8">@Model.IdTipoHabitacionNavigation.Nombre</dd>

                        <dt class="col-sm-4 text-muted">Precio por Noche:</dt>
                        <dd class="col-sm-8">S/. @Model.IdTipoHabitacionNavigation.PrecioNoche.ToString("F2")</dd>
                    </dl>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="IdHabitacion" />
                        <button type="submit" class="btn btn-danger">Confirmar Desactivación</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
