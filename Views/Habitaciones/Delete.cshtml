@model Hotel.Web.Models.Habitacion

@{
    ViewData["Title"] = "Desactivar Habitación";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm border-warning">
                <div class="card-header bg-warning text-dark d-flex align-items-center justify-content-between">
                    <h5 class="mb-0 fw-bold">¿Desea dar de baja esta habitación?</h5>
                    <span class="badge bg-dark">Habitación #@Model.Numero</span>
                </div>
                <div class="card-body">
                    <div class="alert alert-light border-warning text-dark mb-4">
                        <p class="mb-1 fw-semibold">Información importante:</p>
                        <ul class="mb-0 small ps-3">
                            <li>La habitación <strong>no se eliminará del sistema</strong>, pero dejará de estar disponible para nuevas reservas y búsquedas.</li>
                            <li>Todo el historial de reservas y registros pasados se mantendrá seguro e intacto.</li>
                        </ul>
                    </div>

                    <div class="bg-light p-3 rounded mb-3">
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted">Habitación:</dt>
                            <dd class="col-sm-8 fw-bold">Número @Model.Numero</dd>

                            <dt class="col-sm-4 text-muted">Ubicación:</dt>
                            <dd class="col-sm-8">Piso @Model.Piso</dd>

                            <dt class="col-sm-4 text-muted">Tipo:</dt>
                            <dd class="col-sm-8">@Model.IdTipoHabitacionNavigation.Nombre</dd>

                            <dt class="col-sm-4 text-muted">Tarifa:</dt>
                            <dd class="col-sm-8 fw-bold text-success">S/. @Model.IdTipoHabitacionNavigation.PrecioNoche.ToString("F2") por noche</dd>
                        </dl>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-between bg-white py-3">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Cancelar y Volver
                    </a>
                    <form asp-action="Delete" method="post" class="m-0">
                        <input type="hidden" asp-for="IdHabitacion" />
                        <button type="submit" class="btn btn-danger">
                            Sí, Desactivar Habitación
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
