@model IEnumerable<Hotel.Web.Models.Habitacion>

@{
    ViewData["Title"] = "Gestión de Habitaciones";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-door-open"></i> Habitaciones Activas</h2>
            <p class="text-muted">Lista y administración de habitaciones del hotel</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            + Nueva Habitación
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Éxito:</strong> @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label fw-semibold">Filtrar por Tipo de Habitación:</label>
                    <select name="idTipoHabitacion" asp-items="ViewBag.Tipos" class="form-select">
                        <option value="">-- Todos los Tipos --</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-outline-primary">Filtrar</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Número</th>
                        <th>Piso</th>
                        <th>Tipo</th>
                        <th>Capacidad</th>
                        <th>Precio por Noche</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                No se encontraron habitaciones activas.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.Numero</td>
                                <td>Piso @item.Piso</td>
                                <td>
                                    <span class="badge bg-info text-dark">
                                        @item.IdTipoHabitacionNavigation.Nombre
                                    </span>
                                </td>
                                <td>@item.IdTipoHabitacionNavigation.Capacidad persona(s)</td>
                                <td>S/. @item.IdTipoHabitacionNavigation.PrecioNoche.ToString("F2")</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.IdHabitacion" class="btn btn-sm btn-outline-info">Detalles</a>
                                    <a asp-action="Edit" asp-route-id="@item.IdHabitacion" class="btn btn-sm btn-outline-warning">Editar</a>
                                    <a asp-action="Delete" asp-route-id="@item.IdHabitacion" class="btn btn-sm btn-outline-danger">Desactivar</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
