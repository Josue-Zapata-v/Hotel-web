@model Hotel.Web.Models.Habitacion

@{
    ViewData["Title"] = "Editar Habitación";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">Editar Habitación #@Model.Numero</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="IdHabitacion" />
                        <input type="hidden" asp-for="Activo" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Numero" class="form-label fw-semibold">Número de Habitación</label>
                            <input asp-for="Numero" class="form-control" />
                            <span asp-validation-for="Numero" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Piso" class="form-label fw-semibold">Piso</label>
                            <input asp-for="Piso" type="number" class="form-control" min="1" max="50" />
                            <span asp-validation-for="Piso" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="IdTipoHabitacion" class="form-label fw-semibold">Tipo de Habitación</label>
                            <select asp-for="IdTipoHabitacion" class="form-select" asp-items="ViewBag.IdTipoHabitacion">
                            </select>
                            <span asp-validation-for="IdTipoHabitacion" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">Regresar</a>
                            <button type="submit" class="btn btn-warning">Guardar Cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
